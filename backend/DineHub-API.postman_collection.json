{
	"info": {
		"_postman_id": "31b0a880-6e4f-4d69-a7be-3abaf84b8c56",
		"name": "DineHub API",
		"description": "Postman Collection for the DineHub API Gateway",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Auth",
			"item": [
				{
					"name": "Send OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobileNumber\": \"+919876543210\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/send-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"send-otp"
							]
						}
					}
				},
				{
					"name": "Verify OTP",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"mobileNumber\": \"+919876543210\",\n    \"otp\": \"123456\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/verify-otp",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"verify-otp"
							]
						}
					}
				}
			]
		},
		{
			"name": "Restaurant",
			"item": [
				{
					"name": "Setup Restaurant",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"ownerName\": \"John Doe\",\n    \"restaurantName\": \"The Great Cafe\",\n    \"outletName\": \"Main Street Branch\",\n    \"phone\": \"+919876543210\",\n    \"email\": \"contact@greatcafe.com\",\n    \"address\": \"123 Main St, City\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/restaurants/setup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"restaurants",
								"setup"
							]
						}
					}
				}
			]
		},
		{
			"name": "Menu",
			"item": [
				{
					"name": "Get Menu",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/menu?page=1&limit=50",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"menu"
							],
							"query": [
								{
									"key": "page",
									"value": "1"
								},
								{
									"key": "limit",
									"value": "50"
								}
							]
						}
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Create Order",
					"request": {
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{jwtToken}}",
									"type": "string"
								}
							]
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"source\": \"DINE_IN\",\n    \"paymentMethod\": \"CASH\",\n    \"paymentStatus\": \"PENDING\",\n    \"customerName\": \"Alice\",\n    \"tableNumber\": \"5\",\n    \"subtotal\": 500,\n    \"totalAmount\": 525,\n    \"items\": [\n        {\n            \"itemName\": \"Margherita Pizza\",\n            \"qty\": 1,\n            \"price\": 500,\n            \"total\": 500\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/orders",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"orders"
							]
						}
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3000"
		},
		{
			"key": "jwtToken",
			"value": "YOUR_TOKEN_HERE"
		}
	]
}
