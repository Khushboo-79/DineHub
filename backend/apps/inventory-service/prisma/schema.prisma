generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/inventory"
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

model InventoryItem {
  id              String      @id @default(uuid())
  restaurantId    String
  name            String
  category        String
  description     String?
  image           String?     // Base64 string
  unit            String      // e.g., 'KG', 'L', 'Pcs'
  currentStock    Float
  reorderLevel    Float?
  purchasePrice   Float
  supplier        String?
  expiryDate      DateTime?
  isAvailable     Boolean     @default(true)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
