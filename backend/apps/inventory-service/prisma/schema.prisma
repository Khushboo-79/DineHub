generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/inventory"
}

datasource db {
  provider = "postgresql"
  url      = env("INVENTORY_DATABASE_URL")
}

model InventoryItem {
  id              String      @id @default(uuid())
  restaurantId    String
  name            String
  category        String
  description     String?
  image           String?     // Base64 string
  unit            String      // e.g., 'KG', 'L', 'Pcs'
  currentStock    Float
  reorderLevel    Float?
  purchasePrice   Float
  supplier        String?
  expiryDate      DateTime?
  isAvailable     Boolean     @default(true)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  purchaseItems   PurchaseItem[]
  recipeItems     RecipeItem[]
}

model Supplier {
  id              String      @id @default(uuid())
  restaurantId    String
  name            String
  category        String?
  mobile          String
  email           String?
  address         String?
  gstNumber       String?
  status          String      @default("ACTIVE")
  totalPurchase   Float       @default(0)
  pendingAmount   Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  purchases       Purchase[]
}

model Purchase {
  id              String         @id @default(uuid())
  restaurantId    String
  purchaseId      String         @unique // e.g. PUR-1024
  supplierId      String
  supplier        Supplier       @relation(fields: [supplierId], references: [id])
  invoiceNumber   String?
  date            DateTime       @default(now())
  totalAmount     Float
  status          String         // 'Paid', 'Pending', 'Partial'
  items           PurchaseItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model PurchaseItem {
  id              String         @id @default(uuid())
  purchaseId      String
  purchase        Purchase       @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  quantity        Float
  rate            Float
  tax             Float          // percentage e.g. 5
  total           Float
}

model Recipe {
  id              String         @id @default(uuid())
  restaurantId    String
  menuItemId      String         @unique // One recipe per menu item
  items           RecipeItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model RecipeItem {
  id              String         @id @default(uuid())
  recipeId        String
  recipe          Recipe         @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  quantity        Float          // How much of the inventory item is used
}
