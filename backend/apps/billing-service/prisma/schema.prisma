generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/billing"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String        // Foreign key to Order Service
  restaurantId  String        // Foreign key to Restaurant Service
  subtotal      Float
  taxAmount     Float
  discount      Float         @default(0)
  totalAmount   Float
  status        InvoiceStatus @default(DRAFT)
  payments      Payment[]
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  method        PaymentMethod
  transactionId String?       @unique
  status        String        @default("SUCCESS") // SUCCESS, FAILED, REFUNDED
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
}
