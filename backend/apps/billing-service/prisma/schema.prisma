generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/billing"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  VOID
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  NET_BANKING
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  orderId       String        // Foreign key to Order Service
  restaurantId  String        // Foreign key to Restaurant Service
  subtotal      Float
  taxAmount     Float
  discount      Float         @default(0)
  totalAmount   Float
  status        InvoiceStatus @default(DRAFT)
  payments      Payment[]
  issuedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  invoice       Invoice       @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount        Float
  method        PaymentMethod
  transactionId String?       @unique
  status        String        @default("SUCCESS") // SUCCESS, FAILED, REFUNDED
  paidAt        DateTime      @default(now())
  createdAt     DateTime      @default(now())
}

model Subscription {
  id              String   @id @default(uuid())
  ownerId         String   @unique // Foreign key to Auth service User
  plan            String   @default("STARTER") // STARTER, GROWTH, PRO
  status          String   @default("ACTIVE") // ACTIVE, CANCELLED, PAST_DUE
  price           Float
  billingCycle    String   @default("Monthly")
  nextBillingDate DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  payments        SubscriptionPayment[]
}

model SubscriptionPayment {
  id              String       @id @default(uuid())
  subscriptionId  String
  subscription    Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  amount          Float
  method          String
  status          String       @default("PAID")
  date            DateTime     @default(now())
}


enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id              String      @id @default(uuid())
  restaurantId    String      
  openedById      String      
  closedById      String?
  openingFloat    Float
  expectedCash    Float?
  actualCash      Float?
  discrepancy     Float?
  status          ShiftStatus @default(OPEN)
  openedAt        DateTime    @default(now())
  closedAt        DateTime?
  cashDrops       CashDrop[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model CashDrop {
  id            String    @id @default(uuid())
  shiftId       String
  shift         CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amount        Float
  reason        String?
  type          String    @default("DROP") // DROP, PAYIN, PAYOUT
  performedById String
  createdAt     DateTime  @default(now())
}


model Tax {
  id            String   @id @default(uuid())
  restaurantId  String
  name          String   // e.g., "CGST", "SGST", "Liquor Tax"
  rate          Float    // Percentage (e.g., 2.5)
  type          String   @default("PERCENTAGE") // PERCENTAGE, FLAT
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Discount {
  id            String   @id @default(uuid())
  restaurantId  String
  name          String   // e.g., "Happy Hour", "Staff Discount"
  value         Float
  type          String   @default("PERCENTAGE") // PERCENTAGE, FLAT
  minOrderValue Float?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
