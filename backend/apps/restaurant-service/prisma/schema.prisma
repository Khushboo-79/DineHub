generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/restaurant"
}

datasource db {
  provider = "postgresql"
  url      = env("RESTAURANT_DATABASE_URL")
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  ownerId     String   @unique
  logo        String?  // Base64 encoded image or URL
  phone       String?
  email       String?
  address     String?
  isOnboarded Boolean  @default(false)
  outlets     Outlet[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Outlet {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  name          String
  openingTime   String
  closingTime   String
  services      String[]   // e.g., ['DINE_IN', 'TAKEAWAY', 'DELIVERY']
  cuisines      String[]
  hasGST        Boolean    @default(false)
  gstin         String?
  fssaiNumber   String?
  serviceCharge Float?
  invoicePrefix String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}
