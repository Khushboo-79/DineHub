generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client/restaurant"
}

datasource db {
  provider = "postgresql"
  url      = env("RESTAURANT_DATABASE_URL")
}

model Restaurant {
  id          String   @id @default(uuid())
  name        String
  ownerId     String   @unique
  logo        String?  // Base64 encoded image or URL
  phone       String?
  email       String?
  address     String?
  isOnboarded Boolean  @default(false)
  outlets     Outlet[]
  customers   Customer[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Outlet {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  name          String
  openingTime   String
  closingTime   String
  services      String[]   // e.g., ['DINE_IN', 'TAKEAWAY', 'DELIVERY']
  cuisines      String[]
  zones         Zone[]
  reservations  Reservation[]
  hasGST        Boolean    @default(false)
  gstin         String?
  fssaiNumber   String?
  serviceCharge Float?
  invoicePrefix String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}


model Zone {
  id          String   @id @default(uuid())
  outletId    String
  outlet      Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  name        String   // e.g., "Indoor", "Patio", "VIP"
  description String?
  tables      Table[]
  createdAt   DateTime @default(now())
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
  MAINTENANCE
}

model Table {
  id          String      @id @default(uuid())
  zoneId      String
  zone        Zone        @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  name        String      // e.g., "T-01"
  capacity    Int
  status      TableStatus @default(AVAILABLE)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  reservations Reservation[]
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  SEATED
  CANCELLED
  NO_SHOW
}

model Reservation {
  id              String            @id @default(uuid())
  outletId        String
  outlet          Outlet            @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tableId         String?
  table           Table?            @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customerName    String
  customerPhone   String
  guestsCount     Int
  reservationTime DateTime
  status          ReservationStatus @default(PENDING)
  specialRequests String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}


model Customer {
  id              String      @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  loyaltyPoints   Int         @default(0)
  totalSpent      Float       @default(0)
  lastVisit       DateTime?
  visitsCount     Int         @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([restaurantId, phone])
}
