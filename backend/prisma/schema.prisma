// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MANAGER
  STAFF
  CUSTOMER
}

enum OrderSource {
  DOORIQ
  DINE_IN
  SWIGGY
  ZOMATO
}

enum OrderStatus {
  NEW
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  UPI
  CASH
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}


model Restaurant {
  id          String   @id @default(uuid())
  name        String
  ownerId     String   @unique
  logo        String?  // Base64 encoded image or URL
  phone       String?
  email       String?
  address     String?
  isOnboarded Boolean  @default(false)
  outlets     Outlet[]
  categories  MenuCategory[]
  menuItems   MenuItem[]
  inventoryItems InventoryItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Outlet {
  id            String     @id @default(uuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id])
  name          String
  openingTime   String
  closingTime   String
  services      String[]   // e.g., ['DINE_IN', 'TAKEAWAY', 'DELIVERY']
  cuisines      String[]
  hasGST        Boolean    @default(false)
  gstin         String?
  fssaiNumber   String?
  serviceCharge Float?
  invoicePrefix String?
  orders        Order[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}


model MenuCategory {
  id           String     @id @default(uuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id])
  name         String
  items        MenuItem[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model MenuItem {
  id              String            @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant        @relation(fields: [restaurantId], references: [id])
  categoryId      String
  category        MenuCategory      @relation(fields: [categoryId], references: [id])
  name            String
  description     String?
  image           String?           // Base64
  price           Float?            // Optional if variants exist
  gst             Float             @default(0)
  isVeg           Boolean           @default(true)
  preparationTime Int?              // in minutes
  isAvailable     Boolean           @default(true)
  addons          MenuItemAddon[]
  variants        MenuItemVariant[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model MenuItemAddon {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Float
}

model MenuItemVariant {
  id         String   @id @default(uuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String
  price      Float
}

model Order {
  id              String         @id @default(uuid())
  orderNumber     String         @unique // e.g., DQ10245
  outletId        String
  outlet          Outlet         @relation(fields: [outletId], references: [id])
  source          OrderSource    @default(DOORIQ)
  status          OrderStatus    @default(NEW)
  paymentMethod   PaymentMethod  @default(CASH)
  paymentStatus   PaymentStatus  @default(PENDING)
  transactionId   String?
  customerName    String?
  customerPhone   String?
  tableNumber     String?
  guestCount      Int?
  subtotal        Float
  discount        Float          @default(0)
  gst             Float          @default(0)
  totalAmount     Float
  items           OrderItem[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model OrderItem {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemName    String
  addons      String[] // Array of addon names chosen
  qty         Int      @default(1)
  price       Float
  total       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model InventoryItem {
  id              String      @id @default(uuid())
  restaurantId    String
  restaurant      Restaurant  @relation(fields: [restaurantId], references: [id])
  name            String
  category        String
  description     String?
  image           String?     // Base64 string
  unit            String      // e.g., 'KG', 'L', 'Pcs'
  currentStock    Float
  reorderLevel    Float?
  purchasePrice   Float
  supplier        String?
  expiryDate      DateTime?
  isAvailable     Boolean     @default(true)
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}
